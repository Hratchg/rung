T49_API_KEY=            # Terminal49 key from app.terminal49.com/developers. Reads need the 7 day API trial or a paid plan.
RETELL_API_KEY=         # Retell secret key, the one with the webhook badge under API Keys. The only Retell value you paste.
RETELL_PUBLIC_KEY=      # Not needed. Web calls join with the access token from create_web_call.
RETELL_AGENT_ID=        # Written by make retell-setup. Agent id of "Pier 7 gate desk".
RETELL_LLM_ID=          # Written by make retell-setup. The Retell LLM behind the agent.
RETELL_VOICE_ID=        # Optional. Voice for a new agent. Empty picks retell-Cimo when the account has it.
RETELL_FROM_NUMBER=     # E.164 number bought in Retell. make retell-setup binds it to the agent. Only used when RETELL_PHONE_ENABLED=true.
RETELL_PHONE_ENABLED=false
PUBLIC_BASE_URL=        # Written by make tunnel. Tunnel URL for Retell custom functions, for example https://xxxx.trycloudflare.com
SCENARIO_PATH=scenario.json
MINUTES_PER_SECOND=1
