T49_API_KEY=            # Terminal49 key from app.terminal49.com/developers. Reads need the 7 day trial started.
RETELL_API_KEY=         # Retell secret key. Leave empty until Phase 4.
RETELL_PUBLIC_KEY=      # Retell public key for browser web calls.
RETELL_AGENT_ID=        # Agent id of "Pier 7 gate desk".
RETELL_FROM_NUMBER=     # E.164 number bought in Retell. Only used when RETELL_PHONE_ENABLED=true.
RETELL_PHONE_ENABLED=false
PUBLIC_BASE_URL=        # Tunnel URL for Retell custom functions, for example https://xxxx.trycloudflare.com
SCENARIO_PATH=scenario.json
MINUTES_PER_SECOND=1
